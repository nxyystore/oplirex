# Maintainer: nxyy <clubbed@duck.com>
# Prebuilt binary package — fast install (default recommended)
pkgname=oplirex-bin
pkgver=1.0.0
pkgrel=1
pkgdesc="OpenCode Ratelimit Reset via WARP tunnel + Anthropic Proxy Bridge (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/nxyystore/oplire"
license=('MIT')
depends=('glibc' 'gcc-libs')
optdepends=('cloudflare-warp-bin: for WARP tunnel rate limit reset')
provides=('oplire' 'oplirex')
conflicts=('oplire' 'oplirex')
source_x86_64=("oplirex-linux-x86_64.tar.gz::https://github.com/nxyystore/oplirex/releases/download/v$pkgver/oplirex-linux-x86_64.tar.gz")
source_aarch64=("oplirex-linux-aarch64.tar.gz::https://github.com/nxyystore/oplirex/releases/download/v$pkgver/oplirex-linux-aarch64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  install -Dm755 "oplirex" "$pkgdir/usr/bin/oplirex"
  # also provide oplire symlink for compatibility
  ln -s oplirex "$pkgdir/usr/bin/oplire"
  if [ -f LICENSE ]; then
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  fi
}
